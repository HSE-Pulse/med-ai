{
  "uid": "medai-otel",
  "title": "MedAI — OTel Collector",
  "tags": ["medai", "observability", "otel"],
  "description": "Live OpenTelemetry Collector pipeline — span ingestion, processing, export by destination, queue health and resource usage.",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Collector",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [ { "expr": "up{job=\"otel-collector\"}", "legendFormat": "up" } ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ]
        }
      }
    },
    {
      "id": 2,
      "title": "Uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [ { "expr": "otelcol_process_uptime", "legendFormat": "uptime" } ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 3,
      "title": "Spans received /s",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [ { "expr": "sum(rate(otelcol_receiver_accepted_spans[1m]))", "legendFormat": "received/s" } ],
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 4,
      "title": "Spans exported /s",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [ { "expr": "sum(rate(otelcol_exporter_sent_spans[1m]))", "legendFormat": "sent/s" } ],
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 5,
      "title": "Export success ratio",
      "description": "% of spans successfully exported vs failed. Healthy = 100%.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        { "expr": "sum(rate(otelcol_exporter_sent_spans[5m])) / (sum(rate(otelcol_exporter_sent_spans[5m])) + sum(rate(otelcol_exporter_send_failed_spans[5m]))) * 100 OR on() vector(100)", "legendFormat": "success %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 95 }, { "color": "green", "value": 99.5 } ] }
        }
      }
    },
    {
      "id": 10,
      "title": "Span pipeline throughput",
      "description": "End-to-end flow through the collector: receiver → processors → exporters.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(otelcol_receiver_accepted_spans[1m]))", "legendFormat": "received/s" },
        { "expr": "sum(rate(otelcol_exporter_sent_spans[1m]))", "legendFormat": "exported/s" },
        { "expr": "sum(rate(otelcol_receiver_refused_spans[1m]))", "legendFormat": "refused/s" },
        { "expr": "sum(rate(otelcol_exporter_send_failed_spans[1m]))", "legendFormat": "failed/s" },
        { "expr": "sum(rate(otelcol_processor_filter_spans_filtered[1m]))", "legendFormat": "filtered (healthcheck)/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 11,
      "title": "Export rate by destination",
      "description": "Spans exported per second, split by exporter (Jaeger, debug).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (exporter) (rate(otelcol_exporter_sent_spans[1m]))", "legendFormat": "{{exporter}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 20,
      "title": "Exporter queue (size vs capacity)",
      "description": "Backpressure indicator — a rising queue means exporters can't keep up.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (exporter) (otelcol_exporter_queue_size)", "legendFormat": "{{exporter}} size" },
        { "expr": "max(otelcol_exporter_queue_capacity)", "legendFormat": "capacity" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 21,
      "title": "Batch send size (p50 / p95)",
      "description": "Spans per exported batch from the batch processor.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(otelcol_processor_batch_batch_send_size_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(otelcol_processor_batch_batch_send_size_bucket[5m])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 30,
      "title": "Memory (RSS + heap)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "otelcol_process_memory_rss", "legendFormat": "RSS" },
        { "expr": "otelcol_process_runtime_heap_alloc_bytes", "legendFormat": "heap alloc" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 31,
      "title": "CPU usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(otelcol_process_cpu_seconds[1m])", "legendFormat": "cores" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } }
    }
  ]
}
